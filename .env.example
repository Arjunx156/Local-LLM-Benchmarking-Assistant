# ── Ollama ─────────────────────────────────────────────────────────────────
# If Ollama runs on a different machine or port, change this.
OLLAMA_HOST=http://localhost:11434

# The local model used to judge qualitative answers (llm_judge eval method).
# Must be already pulled via `ollama pull <model>`.
JUDGE_MODEL=tinyllama

# ── Benchmark Runner ────────────────────────────────────────────────────────
# How many questions to run at the same time per model.
# Lower if you run out of RAM.
MAX_CONCURRENT_QUESTIONS=3

# Seconds allowed for LLM-generated code to execute before being killed.
CODE_EXEC_TIMEOUT_SEC=10

# ── Paths ───────────────────────────────────────────────────────────────────
REPORTS_DIR=reports
BENCHMARK_SUITES_DIR=benchmark_suites

# ── Networking ──────────────────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# Streamlit uses this URL to reach FastAPI
BACKEND_URL=http://localhost:8000
